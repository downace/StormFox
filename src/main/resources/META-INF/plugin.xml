<idea-plugin url="https://github.com/downace/StormFox">
    <id>com.github.downace.stormfox</id>
    <name>StormFox</name>
    <vendor>Sergey Malchits</vendor>

    <description><![CDATA[
    <p><a href="https://mago.carthage.software/">Mago</a> integration for PHP: format code, lint style and code quality, and analyze types and logic using your project's Mago configuration.</p>
    <p>
        Feel free to <a href="https://github.com/downace/StormFox/issues">report issues</a> if you encounter errors or need more features.
    </p>
    <h3>Features</h3>
    <ul>
        <li><b><a href="https://mago.carthage.software/latest/en/tools/formatter/overview/">Formatter</a>:</b> format PHP files with Reformat code or automatically on save.</li>
        <li><b><a href="https://mago.carthage.software/latest/en/tools/linter/overview/">Linter</a>:</b> see Mago Lint findings directly in the editor and the Problems window.</li>
        <li><b><a href="https://mago.carthage.software/latest/en/tools/analyzer/overview/">Analyzer</a>:</b> inspect type errors and logical issues independently of the linter.</li>
        <li><b><a href="https://mago.carthage.software/latest/en/tools/guard/overview/">Guard</a>:</b> check architectural boundaries and structural conventions.</li>
        <li><b><a href="https://mago.carthage.software/1.60.2/en/guide/installation/#docker">Run Mago in Docker</a>:</b> specify Docker command instead of local path, e.g. <code>docker run --rm -i -v .:/app -w /app ghcr.io/carthage-software/mago:1.60.1</code></li>
    </ul>
    <h3>Getting started</h3>
    <ol>
        <li><a href="https://mago.carthage.software/latest/en/guide/installation/">Install Mago</a> and make sure it runs on your machine.</li>
        <li>
            Install StormFox plugin from the <a href="https://github.com/downace/StormFox/releases">releases page</a>, <a href="https://plugins.jetbrains.com/plugin/35857">JetBrains Marketplace</a>, or directly in the IDE via <strong>Settings | Plugins | Marketplace</strong> (search for <strong>StormFox</strong> or <strong>Mago</strong>).
            <blockquote><i>The marketplace version may lag behind GitHub releases</i></blockquote>
        </li>
        <li>Open <b>Settings | PHP | Quality Tools | Mago</b> and set <b>Mago command</b> to the binary path or a command that starts Mago.</li>
    </ol>
    <ul>
        <li><b>Formatter:</b> enable <b>Use Mago formatter</b>, then use <b>Reformat code</b> (<code>Ctrl+Alt+L</code>). To format files on save, enable <b>Reformat code</b> in <b>Settings | Tools | Actions on Save</b>.</li>
        <li><b>Linter:</b> in <b>Settings | Editor | Inspections</b> enable <b>PHP | Quality tools | Mago Linter validation</b>.</li>
        <li><b>Analyzer:</b> in <b>Settings | Editor | Inspections</b> enable <b>PHP | Quality tools | Mago Analyzer validation</b>.</li>
        <li><b>Guard:</b> in <b>Settings | Editor | Inspections</b> enable <b>PHP | Quality tools | Mago Guard validation</b>.</li>
    </ul>
    ]]></description>

    <change-notes><![CDATA[
    <ul>
        <li><b>Run Mago via Docker, Docker Compose, or a custom command</b>, with project path mapping for containers.</li>
    </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.jetbrains.php</depends>
    <depends>com.intellij.modules.json</depends>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.github.downace.stormfox.MagoVersionProjectStartup"/>
        <codeInsight.linkHandler prefix="stormfox-mago-details:" handlerClass="com.github.downace.stormfox.lint.MagoDiagnosticTooltipLinkHandler"/>
        <codeInsight.linkHandler prefix="stormfox-mago-config:" handlerClass="com.github.downace.stormfox.lint.MagoConfigTooltipLinkHandler"/>
        <localInspection language="PHP" shortName="MagoLint" displayName="Mago Linter validation"
                         groupPath="PHP" groupName="Quality tools" enabledByDefault="false" level="WARNING"
                         implementationClass="com.github.downace.stormfox.lint.MagoLintInspection"/>
        <externalAnnotator language="PHP" implementationClass="com.github.downace.stormfox.lint.MagoLintAnnotator"/>
        <localInspection language="PHP" shortName="MagoAnalyze" displayName="Mago Analyzer validation"
                         groupPath="PHP" groupName="Quality tools" enabledByDefault="false" level="WARNING"
                         implementationClass="com.github.downace.stormfox.lint.MagoAnalyzeInspection"/>
        <externalAnnotator language="PHP" implementationClass="com.github.downace.stormfox.lint.MagoAnalyzeAnnotator"/>
        <localInspection language="PHP" shortName="MagoGuard" displayName="Mago Guard validation"
                         groupPath="PHP" groupName="Quality tools" enabledByDefault="false" level="WARNING"
                         implementationClass="com.github.downace.stormfox.lint.MagoGuardInspection"/>
        <externalAnnotator language="PHP" implementationClass="com.github.downace.stormfox.lint.MagoGuardAnnotator"/>
        <fileIconProvider implementation="com.github.downace.stormfox.config.MagoConfigIconProvider"/>
        <projectConfigurable
                parentId="settings.php.quality.tools"
                id="settings.php.quality.tools.php.mago.formatter"
                displayName="Mago"
                instance="com.github.downace.stormfox.settings.MagoConfigurable"/>

        <formattingService
                id="MagoFormattingService"
                implementation="com.github.downace.stormfox.format.MagoFormattingService"/>

        <notificationGroup id="Mago" displayType="BALLOON"/>
    </extensions>
    <extensions defaultExtensionNs="JavaScript">
        <JsonSchema.ProviderFactory implementation="com.github.downace.stormfox.config.MagoJsonSchemaProviderFactory"/>
    </extensions>
</idea-plugin>
